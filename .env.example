# Resend (resend.com) API key. Without a verified domain, Resend only
# delivers to the account owner's email — CONTACT_TO_EMAIL must be that address.
RESEND_API_KEY=re_your_key_here
CONTACT_TO_EMAIL=you@example.com
# Keep onboarding@resend.dev until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics and the cookie banner entirely.
PUBLIC_GA_ID=
